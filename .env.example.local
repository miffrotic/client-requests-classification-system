# App settings
DEBUG=True
URL_PREFIX="/api"

# JWT settings
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database settings
DB_USER=dev_user
DB_PASSWORD=dev_user
DB_HOST=localhost
DB_PORT=5445
DB_NAME=dev_db
DB_SCHEMA=main_schema
DB_TEST_SCHEMA=test_schema

# Bot settings
BOT_TOKEN="INSERTFROMTELEGRAMBOTFATHER"
BOT_API_URL="https://mysite.com"
BOT_API_EMAIL="bot@admin.com"
BOT_API_PASSWORD="password123"

# LLM / Gemini settings (для AI-агента в bot.py)
GEMINI_API_KEY="INSERT_FROM_https://aistudio.google.com/app/apikey"
GEMINI_MODEL="gemini-2.5-flash"

# Proxy IP and port
HTTP_PROXY="http://xxx.xxx.xxx.xxx:xxxx"
HTTPS_PROXY="http://xxx.xxx.xxx.xxx:xxxx"

# Exceptions for local classifier
NO_PROXY="127.0.0.1, localhost"

# Escalation: chat id (user / group / channel) to which the bot will forward
# alerts about angry customers. Get yours via @userinfobot.
# For groups/channels use a negative id (e.g. -1001234567890).
MANAGER_CHAT_ID=""
